{
  "name": "emotion-nanoreset",
  "description": "Nanoreset for Emotion",
  "version": "1.0.0",
  "author": "Tiaan du Plessis <tiaanduplessis@hotmail.com>",
  "license": "MIT",
  "main": "dist/emotion-nanoreset.js",
  "source": "src/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node inject.js && npm run build:main",
    "build:main": "node scripts/build.mjs",
    "dev": "node inject.js && node scripts/build.mjs --watch",
    "prebuild": "npm run lint",
    "preversion": "npm run build",
    "lint": "eslint src inject.js scripts test eslint.config.mjs",
    "test": "node --test test/*.test.cjs",
    "test:dist": "node scripts/test-dist.cjs",
    "check": "npm run lint && npm run build && npm test && npm run test:dist"
  },
  "homepage": "https://github.com/tiaanduplessis/emotion-nanoreset#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiaanduplessis/emotion-nanoreset.git"
  },
  "bugs": "https://github.com/tiaanduplessis/emotion-nanoreset/issues",
  "keywords": [
    "css",
    "reset",
    "nanoreset",
    "emotion"
  ],
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-babel": "7.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.11.0",
    "rollup": "4.63.5",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "nanoreset": "4.0.0",
    "@emotion/core": "10.3.1",
    "acorn": "8.17.0",
    "@babel/plugin-transform-react-jsx": "7.29.7"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "peerDependencies": {
    "@emotion/core": "^10",
    "react": "^16"
  },
  "packageManager": "yarn@1.22.22"
}
